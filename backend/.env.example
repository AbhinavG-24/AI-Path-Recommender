# Set to true to force deterministic/offline behavior even if an API key is present
DEMO_MODE=true

# Optional: enables LLM-enhanced goal parsing, explanations and the AI tutor.
# If left blank, the app runs fully offline using local ML + rule-based logic.
ANTHROPIC_API_KEY=

# SQLite by default (zero setup). Swap for a Postgres URL in production, e.g.
# postgresql://user:password@localhost:5432/learnpath
DATABASE_URL=sqlite:///./learnpath.db

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
